OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deterministic
DWSIM_HOME=
# Leave blank to use %LOCALAPPDATA%\ThermoEqui-Agent\thermoequi.db.
DATABASE_URL=
APP_ENV=development
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# PGSSI (infinite-dilution activity coefficient prediction)
# ---------------------------------------------------------------------------
# These point at YOUR private trained weights; they are read from the local
# .env file (git-ignored) and are never committed.  Members without weights
# simply leave them blank: PGSSI stays registered but returns a structured
# missing_parameters failure instead of fabricating numbers.
#
# PGSSI_CHECKPOINT: absolute path to the trained *_best.pth (or *_resume.pth)
# PGSSI_SRC: absolute path to the PGSSI repository src/models/PGSSI directory
# PGSSI_HIDDEN_DIM: hidden dimension used at training time (default 512)
# PGSSI_ENABLE_CROSS_INTERACTION: 1 if cross-interaction was enabled (default 1)
PGSSI_CHECKPOINT=
PGSSI_SRC=
PGSSI_HIDDEN_DIM=512
PGSSI_ENABLE_CROSS_INTERACTION=1

# ---------------------------------------------------------------------------
# GHGEAT (infinite-dilution activity coefficient prediction)
# ---------------------------------------------------------------------------
# These point at YOUR private trained weights; they are read from the local
# .env file (git-ignored) and are never committed.  Members without weights
# simply leave them blank: GHGEAT stays registered but returns a structured
# missing_parameters failure instead of fabricating numbers.
#
# GHGEAT_CHECKPOINT: absolute path to the trained GHGEAT.pth file
# GHGEAT_SRC: absolute path to the GHGEAT-master repository root directory
# GHGEAT_HIDDEN_DIM: hidden dimension used at training time (default 38)
# GHGEAT_ATTENTION_WEIGHT: attention weight for the model (default 0.8)
GHGEAT_CHECKPOINT=
GHGEAT_SRC=
GHGEAT_HIDDEN_DIM=38
GHGEAT_ATTENTION_WEIGHT=0.8

# ---------------------------------------------------------------------------
# ThermoFormer (neural VLE prediction from molecular structure)
# ---------------------------------------------------------------------------
# These point at YOUR private trained weights; they are read from the local
# .env file (git-ignored) and are never committed.  Members without weights
# simply leave them blank: ThermoFormer stays registered but returns a
# structured missing_parameters failure instead of fabricating numbers.
#
# ThermoFormer predicts bubble-point VLE (P-x-y, T-x-y) and activity
# coefficients for binary and ternary systems at pressure ≤ 500 kPa.
# Supported calculation types: bubble_point, isothermal_vle, isobaric_vle,
# infinite_dilution_activity.
#
# THERMOFORMER_CHECKPOINT: absolute path to the trained .pt checkpoint
#   (e.g. .../checkpoints/overall_binary_ternary/seed_0/best_model.pt)
# THERMOFORMER_SRC: absolute path to the ThermoFormer repository src directory
# THERMOFORMER_FEATURE_CACHE: optional, defaults to .thermoformer-cache
# THERMOFORMER_USE_CUDA: 1 to attempt CUDA, 0 for CPU (default 1)
THERMOFORMER_CHECKPOINT=
THERMOFORMER_SRC=
THERMOFORMER_FEATURE_CACHE=
THERMOFORMER_USE_CUDA=1
